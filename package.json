{
  "name": "framewise",
  "version": "0.1.0",
  "description": "Turn a video into a lean, deduplicated, high-quality set of frames — ideal for feeding vision LLMs within a token budget",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "framewise": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --bail=5",
    "test:watch": "vitest",
    "release": "doryski-release",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doryski/framewise.git"
  },
  "bugs": {
    "url": "https://github.com/Doryski/framewise/issues"
  },
  "homepage": "https://github.com/Doryski/framewise#readme",
  "keywords": [
    "video",
    "frames",
    "keyframe",
    "ffmpeg",
    "dedupe",
    "perceptual-hash",
    "dhash",
    "vlm",
    "llm",
    "thumbnail",
    "cli",
    "typescript"
  ],
  "author": "Dominik Rycharski (https://github.com/Doryski)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@doryski/release": "^1.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  }
}
